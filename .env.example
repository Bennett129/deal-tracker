# Copy to .env.local. Everything is optional for local development.

# Postgres connection string (Neon). Leave unset to use a local PGlite database
# (stored in the system temp folder, or in PGLITE_DIR if set).
DATABASE_URL=

# Resend API key. Leave unset to print emails (including sign-in links) to the server console.
RESEND_API_KEY=
EMAIL_FROM="Deal Tracker <onboarding@resend.dev>"

# Long random string used to sign session cookies; required in production.
SESSION_SECRET=

# Protects POST /api/sync (manual price sync). Required in production.
SYNC_SECRET=

# Public URL of the site, used for links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest (scheduled sync). Not needed locally with the Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
